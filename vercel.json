{
  "version": 2,
  "builds": [
    { "src": "dist/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/favicon(.*)", "dest": "/public/favicon$1" },
    { "src": "/(.*)", "dest": "/dist/index.js" }
  ]
}
